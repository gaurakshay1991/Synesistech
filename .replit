modules = ["nodejs-22"]
run = "cd model3 && npm install --no-audit --no-fund && npm run build && NODE_ENV=production npm start"
entrypoint = "model3/server/src/provider-front-gateway.js"

[env]
PORT = "3000"
NODE_ENV = "production"

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "cd model3 && npm install --no-audit --no-fund && npm run build && NODE_ENV=production npm start"]

[[ports]]
localPort = 3000
externalPort = 80
