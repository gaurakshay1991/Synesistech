# SYNESIS v9 on Replit — values belong in Replit Secrets, never in source.
NODE_ENV=production
PORT=3000

# Canonical Neon Postgres production database.
DATABASE_URL=set_in_replit_secrets
SYNESIS_ORGANIZATION_NAME=Synesis
SYNESIS_ORGANIZATION_SLUG=synesis

# Keep these stable. Changing the data key makes previously encrypted source text unreadable.
JWT_SECRET=set_a_long_random_value_in_replit_secrets
DATA_ENCRYPTION_KEY=set_a_different_long_random_value_in_replit_secrets

# Optional direct provider bootstrap. SYNESIS v9 can also store/test provider configuration through its provider-control flow.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5-mini

MAX_UPLOAD_MB=15

# Used only if the production database is empty. Existing migrated Neon data already contains the canonical account.
BOOTSTRAP_ADMIN_NAME=Akshay Gaur
BOOTSTRAP_ADMIN_EMAIL=admin@synesis.local
BOOTSTRAP_ADMIN_PASSWORD=set_in_replit_secrets_if_bootstrap_is_needed
