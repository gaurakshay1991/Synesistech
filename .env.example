# LIVE SYNESIS local development environment
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Keep the authenticated private workspace enabled. In production this also
# enforces the required secret checks.
SYNESIS_PUBLIC_MODE=false

# prototype = no paid model calls; live = require OpenAI; auto = use OpenAI
# when available and otherwise retain the deterministic prototype engine.
SYNESIS_AI_MODE=prototype

# Optional override when the local API server is not running on port 3000.
SYNESIS_API_PROXY_TARGET=http://127.0.0.1:3000

# Neon Postgres (use a pooled TLS connection string)
DATABASE_URL=set_in_local_env_only
SYNESIS_ORGANIZATION_NAME=Synesis Development
SYNESIS_ORGANIZATION_SLUG=synesis-dev

# OpenAI — required only when SYNESIS_AI_MODE is live or auto
OPENAI_API_KEY=set_in_local_env_only
OPENAI_MODEL=gpt-5.6-terra

# Local-only fallback when DATABASE_URL is intentionally absent
DATA_FILE=server/data/live-synesis-store.json
MAX_UPLOAD_MB=15

# Keep these values stable. Changing the data key makes previously encrypted
# document text unreadable. Use different values of at least 32 characters.
JWT_SECRET=set_a_long_random_local_value
DATA_ENCRYPTION_KEY=set_a_different_long_random_local_value

# First administrator. Created only when the email does not already exist.
BOOTSTRAP_ADMIN_NAME=Local Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@synesis.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisLocalPassword!123
